# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored; this file (.env.example) is the only one committed.

# Supabase project settings (Project Settings > API in the Supabase
# dashboard). Newer projects label this key "Publishable key"
# (sb_publishable_...) rather than "anon key" -- both are the same role and
# work here; the var name is kept as ANON_KEY since that's still what
# @supabase/ssr and most Supabase docs call it.
# Safe to expose to the browser -- RLS is the actual authorization boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix this with NEXT_PUBLIC_, never import it in a
# Client Component, never log it. Only used by trusted server-side code that
# genuinely needs to bypass RLS (see CLAUDE.md rule #2). Not required for
# Phase 0 -- no server code uses it yet.
SUPABASE_SERVICE_ROLE_KEY=
